DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NextAuth (email/password). Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Optional; defaults to http://localhost:3000 in dev
NEXTAUTH_URL=http://localhost:3000

# Optional browser-rendered fallback for retailers that block server fetches.
# Leave off on Vercel unless you move browser fallback to a compatible worker/function setup.
PLAYWRIGHT_PREVIEW_FALLBACK=0
